{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "rootDir": ".",
    "outDir": "dist-toolchain",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src/language/**/*.ts",
    "src/arcade/classic-rule-contract.ts",
    "src/arcade/classics/**/*.ts",
    "src/cli/**/*.ts",
    "src/lsp/**/*.ts",
    "benchmarks/**/*.ts"
  ]
}
