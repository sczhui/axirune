{
  "Nexilume task": {
    "prefix": "task",
    "description": "Create a typed Nexilume task frame",
    "body": [
      "task ${1:name}",
      "  take ${2:input} ${3:Text}",
      "  give ${4:Text}",
      "  ${5:yield ${2:input}}",
      "/task"
    ]
  },
  "Nexilume tool": {
    "prefix": "tool",
    "description": "Declare an authority-checked tool",
    "body": [
      "tool ${1:namespace.name}",
      "  take ${2:input} ${3:Text}",
      "  give ${4:Text}",
      "  need capability ${5:capability.name}",
      "  permission ${6|ask,allow,deny|}",
      "/tool"
    ]
  },
  "Nexilume agent": {
    "prefix": "agent",
    "description": "Declare a budgeted agent",
    "body": [
      "agent ${1:name}",
      "  model ${2:balanced}",
      "  within ${3:sandbox_name}",
      "  budget tokens ${4:4000}",
      "  budget tool_calls ${5:8}",
      "  handle ${6:work}",
      "/agent"
    ]
  }
}
