{
  "name": "axirune-language",
  "displayName": "Axirune Language",
  "description": "Language support for deterministic Axirune programs and authority-bounded agent workflows.",
  "version": "0.3.1",
  "publisher": "axirune",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": ["Programming Languages", "Linters", "Formatters"],
  "keywords": ["axirune", "deterministic", "task", "agent", "ai", "workflow", "mcp", "capability"],
  "activationEvents": ["onLanguage:axirune"],
  "main": "./extension.cjs",
  "contributes": {
    "languages": [
      {
        "id": "axirune",
        "aliases": ["Axirune", "axirune"],
        "extensions": [".axi", ".nxl"],
        "filenames": ["axirune.pack", "axirune.lock", "nexilume.pack", "nexilume.lock"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "axirune",
        "scopeName": "source.axirune",
        "path": "./syntaxes/axirune.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "axirune",
        "path": "./snippets/axirune.json"
      }
    ],
    "commands": [
      {
        "command": "axirune.restartServer",
        "title": "Axirune: Restart Language Server"
      },
      {
        "command": "axirune.showManifest",
        "title": "Axirune: Show Capability Manifest"
      }
    ],
    "configuration": {
      "title": "Axirune",
      "properties": {
        "axirune.trace.server": {
          "type": "string",
          "enum": ["off", "messages", "verbose"],
          "default": "off",
          "description": "Trace communication with the bundled Axirune language server."
        }
      }
    }
  }
}
