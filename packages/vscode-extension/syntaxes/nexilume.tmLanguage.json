{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nexilume",
  "scopeName": "source.nexilume",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#closers" },
    { "include": "#frames" },
    { "include": "#clauses" },
    { "include": "#builtins" },
    { "include": "#types" },
    { "include": "#numbers" },
    { "include": "#namedArguments" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-dash.nexilume", "match": "--.*$" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.other.guillemet.nexilume",
          "begin": "«",
          "end": "»"
        },
        {
          "name": "string.quoted.double.nexilume",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.nexilume", "match": "\\\\." }
          ]
        }
      ]
    },
    "closers": {
      "patterns": [
        {
          "name": "keyword.control.frame.end.nexilume",
          "match": "^\\s*/(?:shape|form|choice|fault|capability|permission|tool|mcp|memory|context|prompt|sandbox|task|agent|workflow|package)\\b"
        }
      ]
    },
    "frames": {
      "patterns": [
        {
          "name": "keyword.declaration.frame.nexilume",
          "match": "^\\s*(?:space|edition|shape|form|choice|fault|capability|permission|tool|mcp|memory|context|prompt|sandbox|task|agent|workflow|package)\\b"
        }
      ]
    },
    "clauses": {
      "patterns": [
        {
          "name": "keyword.control.clause.nexilume",
          "match": "\\b(?:take|give|field|slot|instruction|attach|expect|effect|resource|need|permission|lifetime|merge|retention|compact|budget|limit|model|remember|grant|within|context|handle|stage|after|recover|retry|backoff|compensate|use|let|emit|yield|call|invoke|launch|as|with|from|trust|allow|deny|version|source|entry|runtime|expose|require|authority|diagnostics)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.nexilume",
          "match": "\\b(?:Any|Nothing|Unit|Bool|Int|Number|Decimal|Text|Bytes|Json|Duration|List|Map|Record|Maybe|Optional|Outcome|Result|Stream|Secret|Observed|Verified|Lease)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.nexilume",
          "match": "\\b(?:Core\\.(?:if|coalesce|type)|Number\\.(?:add|subtract|multiply|divide|remainder|power|abs|min|max|floor|ceil|round|equal|notEqual|less|lessOrEqual|greater|greaterOrEqual)|Bool\\.(?:not|and|or)|Text\\.(?:join|concat|length|upper|lower|trim|contains|startsWith|endsWith|replace|slice|split)|List\\.(?:length|at|append|prepend|concat|slice|contains|reverse|range|map|filter|fold)|Record\\.(?:get|put|has|keys|values|merge)|Json\\.(?:encode|decode)|Outcome\\.(?:ok|fail|isOk|value|fault)|File\\.(?:readText|writeText|exists|list)|Http\\.get)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.nexilume",
          "match": "\\b\\d+(?:\\.\\d+)?\\b"
        }
      ]
    },
    "namedArguments": {
      "patterns": [
        {
          "name": "variable.parameter.nexilume",
          "match": ":[A-Za-z_][A-Za-z0-9_.-]*"
        }
      ]
    }
  }
}
